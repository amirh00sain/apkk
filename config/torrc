# Tor config — minimal SOCKS proxy on localhost for the DPI-bypass stack.
# Start with: tor -f config/torrc
# (Requires the `tor` binary; install via your package manager.)

SOCKSPort 127.0.0.1:9050
ControlPort 127.0.0.1:9051
DataDirectory /tmp/tor-netprobe-data
Log notice stdout

# Avoid writing to a system DataDirectory.
AvoidDiskWrites 1

# Use the fastest circuits (don't need hidden services).
# This is a measurement / analysis tool; do not run as a relay.
ORPort 0
BridgeRelay 0
ServerTransportListenAddr 0
